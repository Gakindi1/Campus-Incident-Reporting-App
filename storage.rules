rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verifiedAlu() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
             .matches('.*@(alustudent|alueducation)[.]com$');
    }

    function isStaff() {
      return verifiedAlu()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
             .data.role == 'staff';
    }

    match /incidents/{uid}/{incidentId}/{fileName} {
      allow read: if verifiedAlu();

      allow create: if verifiedAlu()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if verifiedAlu() && (request.auth.uid == uid || isStaff());
    }
  }
}
